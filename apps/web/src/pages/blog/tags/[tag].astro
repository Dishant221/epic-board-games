---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedPosts, getTagCounts, postUrl, tagUrl, type BlogPost } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getTagCounts();
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}
const { tag, posts } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const label = tag.replace(/-/g, ' ');
const title = `${label.charAt(0).toUpperCase()}${label.slice(1)} guides | Epic Board Games`;
const description = `${posts.length} ${posts.length === 1 ? 'guide' : 'guides'} tagged “${label}”: rules, strategy and tips for playing on Epic Board Games.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: `${site}${tagUrl(tag)}`,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.title, url: `${site}${postUrl(p)}` })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/blog` },
      { '@type': 'ListItem', position: 3, name: `#${tag}`, item: `${site}${tagUrl(tag)}` },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 pt-12 pb-8 md:pt-16">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-400">
      <a href="/" class="hover:text-white">Home</a> <span aria-hidden="true">›</span>
      <a href="/blog" class="hover:text-white">Guides</a> <span aria-hidden="true">›</span>
      <span>#{tag}</span>
    </nav>
    <h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
      Guides tagged <span class="bg-gradient-to-r from-violet-300 to-fuchsia-300 bg-clip-text text-transparent">#{tag}</span>
    </h1>
    <p class="mt-4 text-lg text-slate-300">{description}</p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-8" aria-label="Guides">
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => <PostCard post={post} priority={i === 0} />)}
    </ul>
    <p class="mt-8"><a href="/blog" class="btn-ghost">← All guides</a></p>
  </section>
</BaseLayout>
