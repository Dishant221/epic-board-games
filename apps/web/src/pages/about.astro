---
import { GAMES } from '@ebg/game-core';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site!.toString().replace(/\/$/, '');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Epic Board Games',
    url: `${site}/about`,
    mainEntity: {
      '@type': 'Organization',
      name: 'Epic Board Games',
      url: site,
      logo: `${site}/icon-512.png`,
      description: 'Free multiplayer board games in the browser: Snakes & Ladders, Chess, Checkers, Epic Business, Sudoku, Crossword, Mahjong and more, with AI opponents, friends, voice and text chat.',
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', url: `${site}/contact` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site}/about` },
    ],
  },
];
const values = [
  ['🎲', 'Real rules, real games', 'Every game follows its full, official rules — chess with castling and en passant, checkers with mandatory jumps, a property game with auctions and trades. The same rules code runs in your browser and on our servers, so nobody can cheat.'],
  ['👪', 'Built for families and friends', 'Private rooms, friend and family lists, pings, text and voice chat. Pass-and-play on one device or match with players around the world in under a minute.'],
  ['🤖', 'Opponents for every level', 'Buddy, Nova, Titan and the Oracle: four AI personalities from gentle to perfect play, so beginners learn and experts get a fight.'],
  ['📱', 'Works everywhere', 'Phones, tablets, laptops and 4K screens. No download, no install — open the page and play, fullscreen if you like.'],
  ['🔒', 'Private by design', 'No advertising trackers, hashed passwords, a single session cookie. Export or delete your data in one click from your profile.'],
  ['📖', 'Learn as you play', 'Illustrated how-to-play guides and strategy articles for every game, written by the people who built them.'],
];
---

<BaseLayout
  title="About Epic Board Games — Free Online Board Games for Everyone"
  description="Who we are and why we built Epic Board Games: 12 free browser board games with full rules, AI opponents, multiplayer, friends and voice chat, and a privacy-first design."
  schema={schema}
>
  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-400"><a href="/" class="hover:text-white">Home</a> <span aria-hidden="true">›</span> About</nav>
    <h1 class="text-4xl font-bold sm:text-5xl">Board game night, for everyone, anywhere.</h1>
    <p class="mt-5 max-w-2xl text-lg text-slate-300">
      Epic Board Games started with a simple frustration: the games we grew up playing around a table were scattered across apps full of ads, paywalls and time-limited "energy". We wanted one place where a family in three cities could roll the dice together, where a beginner could learn chess from an AI that goes easy, and where nothing is sold, tracked or locked.
    </p>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      Today the site offers {GAMES.length} games — from a living 3D Snakes, Dragons &amp; Ladders board to full-rules Chess and our own property-trading game, Epic Business — all free, all in the browser, all with the complete rules.
    </p>

    <h2 class="mt-12 text-2xl font-bold">What we care about</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {values.map(([icon, title, text]) => (
        <li class="card p-5">
          <span class="text-3xl" aria-hidden="true">{icon}</span>
          <h3 class="mt-3 font-semibold">{title}</h3>
          <p class="mt-1 text-sm text-slate-400">{text}</p>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 text-2xl font-bold">How the site works</h2>
    <p class="mt-3 text-slate-300">
      Every game is a small, open rules engine that runs both in your browser (for solo play and games against the AI) and inside our game servers (for online play). When you play online, the server checks every move against the rules, rolls the dice and keeps the official state, so disconnections, lag or a mischievous opponent can't corrupt a game. Voice chat travels directly between players and is never recorded.
    </p>
    <p class="mt-3 text-slate-300">
      The site is built on a global edge network so games start quickly wherever you are. Read our <a class="text-violet-300 underline" href="/privacy">Privacy Policy</a> for exactly what we store, and our <a class="text-violet-300 underline" href="/terms">Terms</a> for the house rules.
    </p>

    <h2 class="mt-12 text-2xl font-bold">The games</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {GAMES.map((g) => <li><a href={`/games/${g.slug}`} class="btn-ghost px-3 py-1.5 text-sm">{g.emoji} {g.name}</a></li>)}
    </ul>

    <h2 class="mt-12 text-2xl font-bold">Say hello</h2>
    <p class="mt-3 text-slate-300">
      Found a bug, have a game request, or want to tell us about your family tournament? <a class="text-violet-300 underline" href="/contact">Contact us</a> — a real person reads every message.
    </p>
  </article>
</BaseLayout>
