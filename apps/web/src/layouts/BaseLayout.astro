---
import '../styles/global.css';
import UserMenu from '../components/auth/UserMenu';
import NotificationBell from '../components/social/NotificationBell';
import CookieNotice from '../components/common/CookieNotice';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects to embed. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
  /** Game pages hide the footer and bottom nav for a fullscreen board. */
  immersive?: boolean;
}

const { title, description, schema = [], ogImage = '/og-image.png', noindex = false, immersive = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const image = new URL(ogImage, Astro.site);
const siteName = 'Epic Board Games';

const nav = [
  { href: '/', label: 'Home', icon: '🏠' },
  { href: '/#games', label: 'Games', icon: '🎮' },
  { href: '/blog', label: 'Guides', icon: '📖' },
  { href: '/friends', label: 'Friends', icon: '👥' },
  { href: '/profile', label: 'Profile', icon: '👤' },
];

// `<` could otherwise close the script tag if it ever appeared in content.
const jsonLd = (s: Record<string, unknown>) => JSON.stringify(s).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07071a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Epic Board Games guides" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema.map((s) => <script type="application/ld+json" set:html={jsonLd(s)} />)}
  </head>
  <body class:list={['min-h-dvh', immersive && 'overflow-x-hidden']}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] btn-primary">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-white/5 bg-ink-950/80 backdrop-blur-lg">
      <nav class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4" aria-label="Main">
        <a href="/" class="flex shrink-0 items-center gap-2 font-display text-xl font-bold tracking-tight whitespace-nowrap" aria-label="Epic Board Games home">
          <span aria-hidden="true" class="text-2xl">🎲</span>
          <span class="hidden bg-gradient-to-r from-violet-300 to-fuchsia-300 bg-clip-text text-transparent min-[420px]:inline">Epic Board Games</span>
        </a>
        <ul class="ml-6 hidden items-center gap-1 md:flex">
          {nav.slice(1).map((item) => (
            <li><a href={item.href} class="rounded-lg px-3 py-1.5 text-sm text-slate-300 hover:bg-white/5 hover:text-white">{item.label}</a></li>
          ))}
        </ul>
        <div class="ml-auto flex items-center gap-2">
          <NotificationBell client:idle />
          <UserMenu client:idle />
        </div>
      </nav>
    </header>

    <main id="main" class:list={[!immersive && 'pb-20 md:pb-0']}>
      <slot />
    </main>

    {!immersive && (
      <footer class="mt-24 border-t border-white/5 py-10 text-sm text-slate-400">
        <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 md:flex-row md:items-center md:justify-between">
          <p>© {new Date().getFullYear()} Epic Board Games. Free multiplayer board games in your browser.</p>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            <li><a class="hover:text-white" href="/about">About</a></li>
            <li><a class="hover:text-white" href="/blog">Guides</a></li>
            <li><a class="hover:text-white" href="/contact">Contact</a></li>
            <li><a class="hover:text-white" href="/faq">FAQ</a></li>
            <li><a class="hover:text-white" href="/privacy">Privacy</a></li>
            <li><a class="hover:text-white" href="/cookies">Cookies</a></li>
            <li><a class="hover:text-white" href="/terms">Terms</a></li>
          </ul>
        </div>
      </footer>
    )}

    {!immersive && <CookieNotice client:idle />}

    {!immersive && (
      <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink-950/90 pb-[env(safe-area-inset-bottom)] backdrop-blur-lg md:hidden" aria-label="Bottom">
        <ul class="grid grid-cols-5">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="flex flex-col items-center gap-0.5 py-2 text-[11px] text-slate-300">
                <span aria-hidden="true" class="text-lg">{item.icon}</span>{item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </body>
</html>
